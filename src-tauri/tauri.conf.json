{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bluxit",
  "version": "0.1.2",
  "identifier": "app.bluxit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bluxit",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQzI2MjlFMDQ0MEVERDMKUldUVDdVQUVubUxDWWpRRkF2UitWcXdyckFvdlovQWN0S0hOM1hSZnNmNlFkdWY0eHhnZkNOZVIK",
      "endpoints": [
        "https://github.com/Erigers/bluxit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
